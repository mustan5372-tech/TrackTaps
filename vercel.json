{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/TrackTaps.apk",
      "destination": "https://github.com/mustan5372-tech/TrackTaps/releases/download/v4.0.0/TrackTaps.apk",
      "permanent": false
    },
    {
      "source": "/TrackTaps_v4.0.0.apk",
      "destination": "https://github.com/mustan5372-tech/TrackTaps/releases/download/v4.0.0/TrackTaps.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/version.json",
      "destination": "/version.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
