{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "vite",
  "redirects": [
    {
      "source": "/download",
      "destination": "/TrackTaps.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
